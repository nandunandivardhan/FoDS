import pandas as pd

order_data = pd.DataFrame({
    "Customer_ID": [101, 102, 101, 103, 102, 101],
    "Order_Date": [
        "2026-01-05",
        "2026-01-10",
        "2026-01-15",
        "2026-01-20",
        "2026-01-25",
        "2026-02-01"
    ],
    "Product": [
        "Laptop",
        "Mouse",
        "Keyboard",
        "Laptop",
        "Mouse",
        "Laptop"
    ],
    "Quantity": [1, 2, 1, 2, 3, 1]
})

order_data["Order_Date"] = pd.to_datetime(order_data["Order_Date"])

print("Order Data:")
print(order_data)

orders_by_customer = order_data.groupby("Customer_ID").size()

print("\nTotal orders by each customer:")
print(orders_by_customer)

average_quantity = order_data.groupby("Product")["Quantity"].mean()

print("\nAverage order quantity for each product:")
print(average_quantity)

earliest_date = order_data["Order_Date"].min()
latest_date = order_data["Order_Date"].max()

print("\nEarliest order date:", earliest_date.date())
print("Latest order date:", latest_date.date())
